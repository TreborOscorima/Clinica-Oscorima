FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    sqlmodel==0.0.22 SQLAlchemy==2.0.31 PyMySQL==1.1.1 \
    redis==5.0.8 rq==1.16.2 \
    openpyxl==3.1.2 reportlab==4.0.0 \
    python-dotenv==1.0.1 bcrypt==4.2.1

COPY . .

ENV PYTHONUNBUFFERED=1

CMD ["rq", "worker", "reportes", "--url", "${REDIS_URL}"]
