# =============================================================================
# .env.example — WaykiSAC Clínica
# Copiar a .env y completar los valores antes de arrancar.
#
# LOCAL (Docker):
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
#   Acceso: http://localhost:3004
#
# DESARROLLO NATIVO (sin Docker):
#   MYSQL_HOST=127.0.0.1 y MYSQL_PORT según tu MySQL local (ej. 3307)
#   python -m reflex run   → http://localhost:3003
#
# PRODUCCIÓN (AWS + nginx-proxy-manager):
#   bash scripts/deploy-prod.sh
#   NPM: Proxy Host → tuwayki_life:3000, dominio life.tuwayki.app, WebSockets ON
# =============================================================================

# ── Seguridad ─────────────────────────────────────────────────────────────────
# OBLIGATORIA en producción — mínimo 32 chars aleatorios.
# Nombre alineado con TUWAYKIFOOD y el Sistema de Ventas (AUTH_SECRET_KEY).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=genera-con-python-secrets-token-hex-32

# ── Base de datos MySQL ───────────────────────────────────────────────────────
# Con Docker: el compose inyecta MYSQL_HOST=clinica_mysql — NO setear localhost aquí.
# Desarrollo nativo: descomentar MYSQL_HOST/MYSQL_PORT según tu instalación.
#MYSQL_HOST=127.0.0.1
#MYSQL_PORT=3307
MYSQL_DB=clinica_db
# En Docker el compose crea el usuario "clinica" — NO usar root.
MYSQL_USER=clinica
MYSQL_PASSWORD=your_password_here

# Con Docker: root de clinica_mysql debe tener contraseña DISTINTA a MYSQL_PASSWORD.
MYSQL_ROOT_PASSWORD=your_root_password_here_different

# ── Aplicación ────────────────────────────────────────────────────────────────
# Entorno: dev | prod  (el compose ya inyecta ENV=prod — solo "dev" para nativo)
ENV=dev

# URL pública (los compose overrides la sobreescriben)
# LOCAL: http://localhost:3004 | PROD: https://life.tuwayki.app
PUBLIC_API_URL=http://localhost:3003

# ── Integración con el panel Owner de TUWAYKI ─────────────────────────────────
# Secreto compartido para /api/admin/* — DEBE ser idéntico al LIFE_ADMIN_API_SECRET
# del .env del Sistema de Ventas. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# Si queda vacío, /api/admin/* responde 401 (el Owner no puede gestionar clínicas).
LIFE_ADMIN_API_SECRET=
# Días de prueba para las clínicas que se registran vía /api/registro (1-365).
LIFE_TRIAL_DAYS=15

# Nombre de la clínica para notificaciones y recibos
CLINICA_NOMBRE=Clinica Oscorima

# ── Reportes ──────────────────────────────────────────────────────────────────
REPORT_EXPORT_DIR=exports

# ── Rate limiting de login ────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECS=60

# ── Expiración de sesión ──────────────────────────────────────────────────────
# Horas desde el login tras las que el guard fuerza re-login. Default 12.
SESSION_TTL_HOURS=12

# ── Notificaciones Email (SMTP) — opcional ────────────────────────────────────
NOTIF_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=WaykiSAC

# ── Notificaciones WhatsApp (Twilio) — opcional ───────────────────────────────
NOTIF_WA_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_FROM=whatsapp:+14155238886

# ── Debug ─────────────────────────────────────────────────────────────────────
SQLMODEL_ECHO=false
